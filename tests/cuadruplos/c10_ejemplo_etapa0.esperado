Fila de cuadruplos
  #    operador  izquierdo    derecho      resultado
  1    +         a            b            t1
  2    =         t1           _            r
  3    print     _            _            "La suma es"
  4    print     _            _            r
  5    =         5            _            x
  6    =         10           _            y
  7    =         2.5          _            z
  8    *         y            2            t2
  9    +         x            t2           t3
  10   print     _            _            t3
  11   print     _            _            "resultado"
  12   read      _            _            x

